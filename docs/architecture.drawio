<mxfile host="app.diagrams.net"><diagram id="webpage-auth" name="Web page with Cognito and BFF"><mxGraphModel dx="1700" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="boundary" value="AWS account (dev or prod) - application region us-east-2; CloudFront, WAF scope and ACM certificate are global or us-east-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1320" height="830" as="geometry"/></mxCell><mxCell id="browser" value="Browser (Flutter Web)&#xa;ID and access tokens: memory only&#xa;refresh token: HttpOnly cookie, path /auth, 24 h fixed&#xa;Bearer token only to https or localhost URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="250" height="120" as="geometry"/></mxCell><mxCell id="r53" value="Route 53&#xa;A and AAAA alias + validation record&#xa;dev: over-engineered-simple-calculator.dev.nube-segura.com&#xa;prod: over-engineered-simple-calculator.nube-segura.com" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="1"><mxGeometry x="340" y="70" width="60" height="60" as="geometry"/></mxCell><mxCell id="acm" value="ACM certificate (us-east-1)&#xa;DNS validated" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="60" height="60" as="geometry"/></mxCell><mxCell id="waf" value="Shared WAF web ACL (existing, not created here)&#xa;prod: WAF_WEB_ACL_ARN required (plan fails if empty)&#xa;dev: none" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="60" height="60" as="geometry"/></mxCell><mxCell id="cf" value="CloudFront distribution&#xa;TLS 1.2, HSTS, nosniff, frame DENY, CSP (both behaviors)&#xa;403 and 404 -> 200 /index.html on every behavior&#xa;PriceClass_100 dev, PriceClass_All prod" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="70" height="70" as="geometry"/></mxCell><mxCell id="s3" value="S3 bucket (private, SSE-S3, versioning)&#xa;static Flutter build&#xa;OAC type s3, bucket policy: OAC only, TLS required" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="75" height="78" as="geometry"/></mxCell><mxCell id="bff" value="BFF Lambda (Python 3.14, arm64, 256 MB, 10 s)&#xa;function URL AWS_IAM, OAC type lambda, SigV4 always&#xa;POST /auth/login | /auth/refresh | /auth/logout&#xa;role: own logs + ssm:GetParameter (X-Ray only in prod)&#xa;no reserved concurrency; never answers 403 or 404" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="940" y="320" width="70" height="70" as="geometry"/></mxCell><mxCell id="ssm" value="SSM Parameter Store SecureString (standard tier)&#xa;/oecalc/&lt;env&gt;/auth/app-client-secret&#xa;AWS managed key; written by the auth module" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.parameter_store;" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="75" height="78" as="geometry"/></mxCell><mxCell id="cog" value="Cognito user pool + confidential app client&#xa;admin-created users, no MFA, LITE tier&#xa;refresh 24 h fixed, access and ID 1 h, revocation on&#xa;deletion protection: prod only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="1250" y="350" width="70" height="70" as="geometry"/></mxCell><mxCell id="logs" value="CloudWatch log group&#xa;/aws/lambda/fnc-useast2-oecalc-auth-bff-&lt;env&gt;&#xa;retention 30 d dev, 365 d prod&#xa;alarms: errors and throttles (1 in 5 min)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.alarm;" vertex="1" parent="1"><mxGeometry x="940" y="610" width="60" height="60" as="geometry"/></mxCell><mxCell id="sns2" value="SNS topic us-east-2 (new)&#xa;sns-useast2-oecalc-auth-bff-alerts-&lt;env&gt;&#xa;email subscription, TLS-only policy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="1250" y="610" width="60" height="60" as="geometry"/></mxCell><mxCell id="sns1" value="SNS topic us-east-1 (existing)&#xa;4 certificate-expiry alarms: 90, 60, 30, 15 days&#xa;email subscription" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="60" height="60" as="geometry"/></mxCell><mxCell id="gha" value="GitHub Actions (OIDC deployment role per environment)&#xa;apply order: auth -> auth-bff -> frontend&#xa;smoke tests: page, and POST /auth/refresh -> 401 JSON&#xa;develop deploys dev, main deploys prod (approval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="250" height="110" as="geometry"/></mxCell><mxCell id="back" value="Backends (other repositories): sls API Gateway with Cognito authorizer, ecs&#xa;validate the ID token: issuer, audience, token_use, expiry&#xa;GitHub variables COGNITO_USER_POOL_ID and COGNITO_APP_CLIENT_ID&#xa;(the client ID changes when the secret is enabled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="250" height="140" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS (TB1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="browser" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="web ACL (prod only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;fontSize=10;" edge="1" parent="1" source="waf" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="alias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="r53" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="certificate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="acm" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="default behavior, OAC type s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="cf" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="/auth/* (all 7 methods, no cache), OAC type lambda; InvokeFunctionUrl + InvokeFunction for this distribution only (TB2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="cf" target="bff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="InitiateAuth (SECRET_HASH), GetTokensFromRefreshToken and RevokeToken (ClientSecret); unsigned, TLS (TB3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="bff" target="cog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="GetParameter once at cold start, secret kept in memory (signed, function role)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="bff" target="ssm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="structured logs, no secrets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="bff" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="alarm and OK actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="logs" target="sns2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Authorization: Bearer ID token (direct, cross-origin, TB4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=10;" edge="1" parent="1" source="browser" target="back"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="validate JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;fontSize=10;" edge="1" parent="1" source="back" target="cog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="deploys (Terragrunt apply, Flutter build, S3 sync)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;fontSize=10;" edge="1" parent="1" source="gha" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
