<mxfile host="app.diagrams.net">
  <diagram id="webpage-auth" name="Web page with Cognito and BFF">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="browser" value="Browser (Flutter Web)&#xa;ID/access token: memory only&#xa;refresh token: HttpOnly cookie (path /auth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="AWS account (dev or prod) - region us-east-2 / global" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=10;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="1020" height="780" as="geometry"/>
        </mxCell>
        <mxCell id="waf" value="Shared WAF web ACL (existing, prod only, passed by ARN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cf" value="CloudFront distribution&#xa;custom domain + ACM, TLS 1.2, security headers + CSP&#xa;/auth/* : no cache, forwards cookie and Origin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="S3 bucket (private)&#xa;static Flutter build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="bff" value="BFF Lambda (Python, arm64)&#xa;function URL, AWS_IAM, OAC only&#xa;POST /auth/login | refresh | logout&#xa;role: write own logs only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="330" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="cognito" value="Amazon Cognito user pool + app client&#xa;local users created by the owner, no MFA&#xa;refresh 24 h, access/ID 1 h, revocation on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="330" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="logs" value="CloudWatch Logs + alarms (Errors, Throttles) -> new SNS topic in us-east-2 -> email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="backend" value="Backends (other repositories): sls API Gateway authorizer, ecs&#xa;validate the ID token of the same pool&#xa;GitHub variables COGNITO_USER_POOL_ID, COGNITO_APP_CLIENT_ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="660" width="660" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ci" value="GitHub Actions (OIDC deploy role)&#xa;Terragrunt apply, Flutter build, S3 sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="520" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTPS (TB1)" style="endArrow=classic;html=1;" edge="1" parent="1" source="browser" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="web ACL (prod)" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="waf" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="default behavior, OAC" style="endArrow=classic;html=1;" edge="1" parent="1" source="cf" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="/auth/*, OAC SigV4 (TB2)" style="endArrow=classic;html=1;" edge="1" parent="1" source="cf" target="bff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="InitiateAuth / GetTokensFromRefreshToken / RevokeToken (TB3, unsigned, client secret, TLS)" style="endArrow=classic;html=1;" edge="1" parent="1" source="bff" target="cognito"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="logs" style="endArrow=classic;html=1;" edge="1" parent="1" source="bff" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Authorization: Bearer ID token (TB4, direct, cross-origin)" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="browser" target="backend"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="validate JWT (issuer, audience, expiry)" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="backend" target="cognito"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="deploys" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="ci" target="bff"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
