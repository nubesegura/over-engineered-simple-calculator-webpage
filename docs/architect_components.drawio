" value="Shared WAF web ACL&lt;br&gt;prod only, by ARN&lt;br&gt;(not in this repo)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;verticalAlign=middle;align=center;fontSize=12;fontStyle=0;fontColor=#232F3E;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="240" width="210" height="120" as="geometry"/></mxCell><mxCell id="cf" value="CloudFront distribution&lt;br&gt;cfd-useast2-oecalc-web-&amp;lt;env&amp;gt;" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=13;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="721" y="461" width="78" height="78" as="geometry"/></mxCell><mxCell id="cfnote" value="Same stack: web and BFF origin access controls, response headers policy (HSTS, CSP), two Lambda permissions, behavior /auth/* to the BFF." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=top;align=left;fontSize=12;fontColor=#232F3E;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="640" width="390" height="120" as="geometry"/></mxCell><mxCell id="acm" value="ACM certificate&lt;br&gt;DNS validated" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=13;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager_3;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;" vertex="1" parent="1"><mxGeometry x="561" y="1161" width="78" height="78" as="geometry"/></mxCell><mxCell id="alm1" value="2 expiry alarms&lt;br&gt;30 and 7 days" style="sketch=0;outlineConnect=0;html=1;whiteSpace=nowrap;aspect=fixed;fontSize=13;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashe